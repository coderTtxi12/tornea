# Copy to `.env.development.local` for local development (Next loads it with `npm run dev`).
# In production, set the same variables in your host environment or `.env.production.local`.

# NODE_ENV — Do not add this file line unless you have a specific reason.
# Next.js sets it for you: `npm run dev` → development, `npm run build` / `npm run start` → production.
# The Firebase setup hint on the login page only appears when Firebase env vars are missing AND NODE_ENV is development.

DATABASE_URL=postgresql://user:password@localhost:5432/tornea

# Firebase (Web app) — Project settings → Your apps → SDK snippet (config).
# Enable Google provider: Authentication → Sign-in method → Google.
# measurementId: Analytics (Google Analytics). Optional if you only use Auth.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

