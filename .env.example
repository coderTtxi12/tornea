# Copy to `.env.development.local` for local development (Next loads it with `npm run dev`).
# In production, set the same variables in your host environment or `.env.production.local`.

# NODE_ENV — Do not add this file line unless you have a specific reason.
# Next.js sets it for you: `npm run dev` → development, `npm run build` / `npm run start` → production.

# PostgreSQL — Drizzle migrations (`npm run db:migrate`) y queries del servidor (`getDb()`).
# Supabase → Project Settings → Database → Connection string (URI).
# Para migraciones, suele ir mejor la conexión "direct" (host db.[ref].supabase.co:5432)
# que el pooler transaction (puerto 6543).
# IMPORTANTE: la misma DATABASE_URL debe estar en el archivo que realmente use Next en dev
# (a menudo `.env.development.local`). Los scripts `db:migrate` y `db:apply:sql` cargan la misma
# cadena que Next: .env → .env.local → .env.development → .env.development.local
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase — Project Settings → API (Project URL + anon public key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Storage — bucket para escudos de liga (default: tornea). Crear el bucket en Supabase si no existe.
SUPABASE_STORAGE_BUCKET=tornea

# Service role (solo servidor, nunca NEXT_PUBLIC_* ni el cliente).
# Supabase → Project Settings → API → service_role (secret).
# Úsala para que `POST /api/leagues` suba el escudo sin chocar con RLS de Storage.
# Sin esta variable, las subidas usan la sesión del usuario y necesitas políticas en `storage.objects`.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL for OAuth / magic-link redirects when building URLs without `window`
# (production). On Vercel you can omit this if users always hit your primary domain.
# Also add redirect allow-list patterns in Supabase → Authentication → URL Configuration:
# - Production: https://your-domain.com/**
# - Local: http://localhost:3000/**
# - Vercel previews: https://*-<team-slug>.vercel.app/** (see Supabase redirect URLs guide)
NEXT_PUBLIC_SITE_URL=
